{% extends 'base.html.twig' %}

{% import 'core/default_templates/form_search.html.twig' as form_search %}
{% import 'core/default_templates/data_table_macro.html.twig' as data_table %}

{% block body %}
    {{ form_search.form_search(form, ["name", "address"]) }}

    {{ data_table.table(rows, {
        "newLink": data_table.new_btn('warehouse_create'),
        "cols" : {
            "tableAction": {
                "label": "core.module.actionTitle",
                "edit": path('warehouse_edit', {"id": -1}),
            },
            "name": {
                "label": "warehouse.name",
            },
            "address": {
                "label": "warehouse.address",
            },
            "description": {
                "label": "warehouse.description",
            },
            "createdAt": {
                "label": "warehouse.created_at",
                "type": "datetime",
            },
            "createdBy.username": {
                "label": "warehouse.created_by",
            },
        }
    }) }}
{% endblock %} 